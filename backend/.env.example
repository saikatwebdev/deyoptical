# ─────────────────────────────────────────────────────────────────────────────
# Dey Optical Backend — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# MongoDB connection URI
# For MongoDB Atlas:  mongodb+srv://<username>:<password>@cluster.mongodb.net/deyoptical?retryWrites=true&w=majority
# For local MongoDB:  mongodb://127.0.0.1:27017/deyoptical
MONGODB_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@cluster.mongodb.net/deyoptical?retryWrites=true&w=majority

# JWT secret — use a long, random string (at least 64 chars)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_HERE_64_CHARS_MINIMUM

# JWT token expiry
JWT_EXPIRES_IN=8h

# Admin credentials (single owner account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=deyadmin2026

# Frontend origins allowed by CORS (comma-separated if multiple, no trailing slashes)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Node environment
NODE_ENV=development

